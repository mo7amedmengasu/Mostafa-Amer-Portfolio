---
const nav = [
  ['Journey', '#journey'],
  ['Focus', '#focus'],
  ['Service', '#service'],
  ['Learning', '#learning'],
  ['Beyond', '#beyond'],
];
---

<div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
<header class="site-header" data-header>
  <a class="monogram" href="#top" aria-label="Mostafa Amer — home">
    <span>MA</span>
    <svg viewBox="0 0 64 22" aria-hidden="true">
      <path d="M1 11h14l4-8 7 17 6-12 4 6h27" />
    </svg>
  </a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
    <span class="sr-only">Toggle navigation</span>
    <span></span><span></span>
  </button>
  <nav id="site-nav" class="site-nav" aria-label="Primary navigation">
    <ul>
      {nav.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
    </ul>
    <a class="nav-cta" href="#contact">Get in touch <span aria-hidden="true">↗</span></a>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('.site-nav');
  const closeMenu = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    nav?.classList.remove('is-open');
    document.body.classList.remove('menu-open');
  };
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
    document.body.classList.toggle('menu-open', open);
  });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  addEventListener('keydown', (event) => event.key === 'Escape' && closeMenu());
</script>
